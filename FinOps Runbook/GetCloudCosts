const { app } = require('@azure/functions');
const { DefaultAzureCredential } = require('@azure/identity');
const { CostManagementClient } = require('@azure/arm-costmanagement');

app.http('GetCloudCosts', {
    methods: ['GET'],
    authLevel: 'anonymous',
    handler: async (request, context) => {
        try {
            // DefaultAzureCredential pulls Managed Identity token in production 
            // and uses your local Azure CLI sign-in during VS Code debugging.
            const credential = new DefaultAzureCredential();
            const subscriptionId = process.env.AZURE_SUBSCRIPTION_ID;
            
            if (!subscriptionId) {
                return { 
                    status: 400, 
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ error: "Missing AZURE_SUBSCRIPTION_ID environment variable." }) 
                };
            }

            const client = new CostManagementClient(credential);
            const scope = `/subscriptions/${subscriptionId}`;

            // Execute an aggregated payload query over the current billing cycle
            const queryResult = await client.query.usage(scope, {
                type: 'ActualCost',
                timeframe: 'MonthToDate',
                dataset: {
                    granularity: 'Daily',
                    aggregation: {
                        totalCost: { name: 'PreTaxCost', function: 'Sum' }
                    }
                }
            });

            // Map and parse row matrices into flat JSON array objects for Recharts
            const formattedData = queryResult.rows ? queryResult.rows.map(row => ({
                cost: row[0],
                date: row[1]
            })) : [];

            return {
                status: 200,
                headers: { 
                    'Content-Type': 'application/json',
                    'Access-Control-Allow-Origin': '*' // Handles testing CORS limits
                },
                body: JSON.stringify(formattedData)
            };

        } catch (error) {
            context.log(`FinOps Data Retrieval Failure: ${error.message}`);
            return { 
                status: 500, 
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ error: "Internal cloud communication exception." }) 
            };
        }
    }
});
